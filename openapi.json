      "get": {
        "operationId": "AutoresController_listar",
        "parameters": [
          {
            "name": "pagina",
            "required": false,
            "in": "query",
            "description": "Número da página desejada.",
            "schema": {
              "minimum": 1,
              "default": 1,
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "tamanho",
            "required": false,
            "in": "query",
            "description": "Quantidade máxima de registros por página.",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "example": 10,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista paginada de autores.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/RespostaPaginada"
                    },
                    {
                      "properties": {
                        "dados": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AutorResposta"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros de paginação inválidos."
          }
        },
        "summary": "Listar autores com paginação",
        "tags": [
          "Autores"
        ]
      }
    },
