  "info": {
    "title": "BiblioCom API",
    "description": "API para gerenciamento de autores, obras e exemplares de uma biblioteca.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Autores",
      "description": "Gerenciamento de autores"
    },
    {
      "name": "Obras",
      "description": "Gerenciamento de obras"
    },
    {
      "name": "Exemplares",
      "description": "Gerenciamento de exemplares"
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "CreateTarefaDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateTarefaDto": {
        "type": "object",
        "properties": {}
      },
      "CreateCategoriaDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateCategoriaDto": {
        "type": "object",
        "properties": {}
      },
      "RespostaPaginada": {
        "type": "object",
        "properties": {
          "dados": {
            "description": "Registros retornados na página atual.",
            "type": "array",
            "items": {
              "type": "array"
            }
          },
          "total": {
            "type": "number",
            "description": "Quantidade total de registros encontrados.",
            "example": 50
          },
          "pagina": {
            "type": "number",
            "description": "Número da página atual.",
            "example": 1
          },
          "tamanho": {
            "type": "number",
            "description": "Quantidade de registros por página.",
            "example": 10
          },
          "totalPaginas": {
            "type": "number",
            "description": "Quantidade total de páginas.",
            "example": 5
          }
        },
        "required": [
          "dados",
          "total",
          "pagina",
          "tamanho",
          "totalPaginas"
        ]
      },
      "AutorResposta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Identificador do autor.",
            "example": 1
          },
          "nome": {
            "type": "string",
            "description": "Nome completo do autor.",
            "example": "Machado de Assis"
          }
        },
        "required": [
          "id",
          "nome"
        ]
      },
      "CriarAutorDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "description": "Nome completo do autor.",
            "example": "Machado de Assis",
            "minLength": 2,
            "maxLength": 150
          }
        },
        "required": [
          "nome"
        ]
      },
      "AtualizarAutorDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "description": "Nome completo do autor.",
            "example": "Machado de Assis",
            "minLength": 2,
            "maxLength": 150
          }
        }
      },
      "ObraResposta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Identificador da obra.",
            "example": 1
          },
          "titulo": {
            "type": "string",
            "description": "Título da obra.",
            "example": "Dom Casmurro"
          },
          "isbn": {
            "type": "object",
            "description": "ISBN da obra, quando disponível.",
            "example": "9788535910663",
            "nullable": true
          },
          "anoPublicacao": {
            "type": "number",
            "description": "Ano de publicação.",
            "example": 1899
          },
          "autorNome": {
            "type": "string",
            "description": "Nome do autor relacionado à obra.",
            "example": "Machado de Assis"
          }
        },
        "required": [
          "id",
          "titulo",
          "isbn",
          "anoPublicacao",
          "autorNome"
        ]
      },
      "CriarObraDto": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "description": "Título da obra.",
            "example": "Dom Casmurro",
            "maxLength": 200
          },
          "isbn": {
            "type": "object",
            "description": "ISBN da obra. Pode ser nulo ou não informado.",
            "example": "9788535910663",
            "maxLength": 20,
            "nullable": true
          },
